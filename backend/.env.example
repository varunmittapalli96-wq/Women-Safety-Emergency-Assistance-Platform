# ==============================================================================
# bSafe Backend — Environment Configuration Template
# ==============================================================================

# Server Network Configuration (express, cors)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection (mongoose, mongodb)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bsafe?retryWrites=true&w=majority

# Security & JWT Authentication (jsonwebtoken, bcryptjs)
# Must be at least 32 characters long
JWT_SECRET=bsafe_jwt_secret_key_2024_change_in_production
JWT_EXPIRES_IN=7d

# Firebase Project ID (for verifying client ID tokens server-side)
FIREBASE_PROJECT_ID=bsafe-f874c

# Google OAuth 2.0 Credentials (google-auth-library)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
