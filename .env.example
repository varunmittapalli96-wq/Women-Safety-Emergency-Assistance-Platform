# ==============================================================================
# bSafe — Women Safety & Emergency Assistance Platform
# MASTER ENVIRONMENT TEMPLATE FOR ALL LIBRARIES & PACKAGES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (express, cors, helmet, rate-limit)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (mongoose, mongodb)
# ------------------------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas or local: mongodb://localhost:27017/bsafe)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bsafe?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (jsonwebtoken, bcryptjs)
# ------------------------------------------------------------------------------
# Secret key for signing and verifying JWTs (minimum 32 characters in production)
JWT_SECRET=bsafe_jwt_secret_key_2024_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. FIREBASE AUTHENTICATION & ANALYTICS (firebase)
# ------------------------------------------------------------------------------
# Firebase project credentials used by frontend SDK and backend token validator
FIREBASE_PROJECT_ID=bsafe-f874c
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCyIzdm0ClkjzcuKoYrh79NidAVKQlQHGI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bsafe-f874c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bsafe-f874c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bsafe-f874c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=707194993827
NEXT_PUBLIC_FIREBASE_APP_ID=1:707194993827:web:427c2e30c0c66f79a51316
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-2JYNG9ZVRP

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (google-auth-library)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth Credentials (used for direct OAuth 2.0 redirect flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 6. FRONTEND APPLICATION (next, react, leaflet, socket.io-client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
